# 与 LibreChat 使用同一 MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# 可选：设置后所有 API 需携带 Authorization: Bearer <token>
CHAT_MANAGER_ADMIN_TOKEN=

# 禁用账户时写入 LibreChat Ban 的时长（毫秒）。需 LibreChat 开启 BAN_VIOLATIONS=true
# 封禁数据写入 MongoDB 的 logs 集合（与 LibreChat keyvMongo 一致，不是 keyv）
# CHAT_MANAGER_BAN_DURATION_MS=3153600000000
