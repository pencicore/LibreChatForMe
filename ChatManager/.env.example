# 与 LibreChat 使用同一 MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# 与 LibreChat 相同的 JWT 密钥（启用登录后必填）
JWT_SECRET=hahahahahahahahahahahahahahahahahahahahaha

# LibreChat 后端地址（优先通过管理端登录接口校验；未设置时直连 MongoDB 校验）
# LIBRECHAT_API_URL=http://localhost:3080

# 可选：静态 API Token，与登录并存，便于脚本调用（Authorization: Bearer <token>）
CHAT_MANAGER_ADMIN_TOKEN=

# 禁用账户时写入 LibreChat Ban 的时长（毫秒）。需 LibreChat 开启 BAN_VIOLATIONS=true
# 封禁数据写入 MongoDB 的 logs 集合（与 LibreChat keyvMongo 一致，不是 keyv）
# CHAT_MANAGER_BAN_DURATION_MS=3153600000000

# LibreChat 违规缓存目录（用于启用用户时清理登录限流文件，可选）
# LIBRECHAT_DATA_DIR=../LibreChat/api/data
